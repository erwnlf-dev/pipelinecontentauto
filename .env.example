# ── Claude (Anthropic API) ─────────────────────────────────────────────
# Buat key di Console org yang di-link ke Team plan (kredit API Team terpakai dulu).
# Jangan pakai login subscription/OAuth untuk backend.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# ── Google Gemini API (video Omni + gambar) ────────────────────────────
# Butuh Cloud Billing; US$10/bulan credits Google AI Pro jadi potongan.
GEMINI_API_KEY=
# GEMINI_VIDEO_MODEL=gemini-omni-1.1-flash   # alternatif murah: veo-3.1-lite-generate-preview
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# ── ElevenLabs ─────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2   # atau eleven_v4 (cek dukungan /with-timestamps)
# ELEVENLABS_LANGUAGE_CODE=id

# ── Guardrail biaya ────────────────────────────────────────────────────
BUDGET_PER_VIDEO_USD=5
BUDGET_PER_DAY_USD=20
# KILL_SWITCH=1   # tolak semua pemakaian provider berbayar

# ── Database (fase berikutnya: pg-boss + dashboard) ────────────────────
DATABASE_URL=postgres://pca:pca@localhost:5432/pca

# ── Render ─────────────────────────────────────────────────────────────
# Path Chrome headless shell bila tidak ingin Remotion mengunduh browser sendiri.
# REMOTION_BROWSER_EXECUTABLE=
